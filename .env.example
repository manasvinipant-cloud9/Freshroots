# Neon Postgres connection string (Neon dashboard -> Connection details, pooled)
DATABASE_URL=postgresql://user:pass@ep-xxxx.region.aws.neon.tech/neondb?sslmode=require

# Gemini (Google AI Studio key). Models are config, never hardcoded in code.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Used for the one retry when the primary model fails
GEMINI_FALLBACK_MODEL=gemini-flash-latest

# Secures /api/cron/run. Vercel Cron sends it as "Authorization: Bearer <CRON_SECRET>"
CRON_SECRET=

# Shared passcode that gates the whole app (cron route is exempt). Leave empty for open local dev.
APP_PASSCODE=

# Name written to the audit log when none is supplied
DEFAULT_USER=raghav

# Zoho Inventory (disabled by default; the dry-run client is used unless enabled)
ZOHO_PO_ENABLED=false
ZOHO_API_BASE=https://www.zohoapis.in/inventory/v1
ZOHO_ORG_ID=
ZOHO_ACCESS_TOKEN=
